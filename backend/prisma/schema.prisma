generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  STAROSTA
  TEACHER
}

enum LessonType {
  LECTURE
  PRACTICE
  LAB
}

enum GradeType {
  CURRENT
  TEST
  HOMEWORK
  EXAM
}

model Faculty {
  id        String  @id @default(cuid())
  name      String
  shortName String  @unique
  groups    Group[]
}

model Group {
  id        String   @id @default(cuid())
  name      String   @unique
  facultyId String
  faculty   Faculty  @relation(fields: [facultyId], references: [id])

  users           User[]
  scheduleEntries ScheduleEntry[]
  homework        Homework[]
  grades          Grade[]
  teacherLinks    TeacherSubject[]
}

model User {
  id         String   @id @default(cuid())
  telegramId BigInt   @unique
  firstName  String
  lastName   String?
  username   String?
  role       Role?
  groupId    String?
  group      Group?   @relation(fields: [groupId], references: [id])
  createdAt  DateTime @default(now())

  homeworkCreated  Homework[]       @relation("HomeworkAuthor")
  gradesGiven      Grade[]          @relation("GradeAuthor")
  gradesReceived   Grade[]          @relation("GradeStudent")
  teachingSubjects TeacherSubject[]
}

model Subject {
  id   String @id @default(cuid())
  name String @unique

  scheduleEntries ScheduleEntry[]
  homework        Homework[]
  grades          Grade[]
  teachers        TeacherSubject[]
}

// Links a teacher to a (subject, group) pair they are allowed to teach,
// grade, and set homework for. This is the source of truth for grading rights.
model TeacherSubject {
  id        String  @id @default(cuid())
  teacherId String
  teacher   User    @relation(fields: [teacherId], references: [id])
  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])
  groupId   String
  group     Group   @relation(fields: [groupId], references: [id])

  @@unique([teacherId, subjectId, groupId])
}

model ScheduleEntry {
  id        String     @id @default(cuid())
  groupId   String
  group     Group      @relation(fields: [groupId], references: [id])
  subjectId String
  subject   Subject    @relation(fields: [subjectId], references: [id])
  dayOfWeek Int // 1 = Monday ... 6 = Saturday
  startTime String // "09:00"
  endTime   String // "10:30"
  room      String?
  type      LessonType @default(LECTURE)

  homework Homework[]
}

model Homework {
  id              String         @id @default(cuid())
  groupId         String
  group           Group          @relation(fields: [groupId], references: [id])
  subjectId       String
  subject         Subject        @relation(fields: [subjectId], references: [id])
  scheduleEntryId String?
  scheduleEntry   ScheduleEntry? @relation(fields: [scheduleEntryId], references: [id])
  deadline        DateTime
  text            String
  createdById     String
  createdBy       User           @relation("HomeworkAuthor", fields: [createdById], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Grade {
  id        String    @id @default(cuid())
  studentId String
  student   User      @relation("GradeStudent", fields: [studentId], references: [id])
  subjectId String
  subject   Subject   @relation(fields: [subjectId], references: [id])
  groupId   String
  group     Group     @relation(fields: [groupId], references: [id])
  date      DateTime
  value     Int // 1-10, Belarusian scale
  type      GradeType @default(CURRENT)
  comment   String?
  teacherId String
  teacher   User      @relation("GradeAuthor", fields: [teacherId], references: [id])
  createdAt DateTime  @default(now())
}
