# Postgres connection string from Railway (Project -> Postgres -> Connect -> DATABASE_URL)
DATABASE_URL="postgresql://user:password@host:5432/railway"

# Token from @BotFather for the Telegram bot behind this Mini App
TELEGRAM_BOT_TOKEN="123456:ABC-example-token"

# Random 32+ char secret used to sign session cookies (generate with: openssl rand -hex 32)
SESSION_SECRET="change-me-to-a-long-random-string"
