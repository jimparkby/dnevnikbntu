{
  "name": "dnevnik-bntu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate --schema=backend/prisma/schema.prisma && next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "prisma db push --schema=backend/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --schema=backend/prisma/schema.prisma",
    "db:seed": "tsx backend/prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "jose": "^5.9.6",
    "next": "^14.2.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "prisma": "^5.20.0",
    "tailwindcss": "^3.4.13",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  },
  "prisma": {
    "schema": "backend/prisma/schema.prisma",
    "seed": "tsx backend/prisma/seed.ts"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "esbuild@0.28.2": true,
    "prisma@5.22.0": true
  }
}
